{
  "name": "veloce-ts",
  "version": "3.1.2",
  "description": "A modern, fast web framework for TypeScript with authentication, RBAC, GraphQL, WebSockets, and response caching",
  "type": "module",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "veloce-ts": "./bin/veloce.mjs",
    "veloce": "./bin/veloce.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/src/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/cjs/src/index.js"
      },
      "default": "./dist/esm/src/index.js"
    },
    "./validation": {
      "import": {
        "types": "./dist/types/validation/index.d.ts",
        "default": "./dist/esm/src/validation/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/validation/index.d.ts",
        "default": "./dist/cjs/src/validation/index.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/types/middleware/index.d.ts",
        "default": "./dist/esm/src/middleware/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/middleware/index.d.ts",
        "default": "./dist/cjs/src/middleware/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/types/testing/index.d.ts",
        "default": "./dist/esm/src/testing/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/testing/index.d.ts",
        "default": "./dist/cjs/src/testing/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/types/errors/index.d.ts",
        "default": "./dist/esm/src/errors/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/errors/index.d.ts",
        "default": "./dist/cjs/src/errors/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/types/index.d.ts",
        "default": "./dist/esm/src/types/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/types/index.d.ts",
        "default": "./dist/cjs/src/types/index.js"
      }
    },
    "./docs": {
      "import": {
        "types": "./dist/types/docs/index.d.ts",
        "default": "./dist/esm/src/docs/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/docs/index.d.ts",
        "default": "./dist/cjs/src/docs/index.js"
      }
    },
    "./graphql": {
      "import": {
        "types": "./dist/types/graphql/index.d.ts",
        "default": "./dist/esm/src/graphql/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/graphql/index.d.ts",
        "default": "./dist/cjs/src/graphql/index.js"
      }
    },
    "./websocket": {
      "import": {
        "types": "./dist/types/websocket/index.d.ts",
        "default": "./dist/esm/src/websocket/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/websocket/index.d.ts",
        "default": "./dist/cjs/src/websocket/index.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/types/plugins/index.d.ts",
        "default": "./dist/esm/src/plugins/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/plugins/index.d.ts",
        "default": "./dist/cjs/src/plugins/index.js"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/types/cli/index.d.ts",
        "default": "./dist/esm/src/cli/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/cli/index.d.ts",
        "default": "./dist/cjs/src/cli/index.js"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/types/auth/index.d.ts",
        "default": "./dist/esm/src/auth/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/auth/index.d.ts",
        "default": "./dist/cjs/src/auth/index.js"
      }
    },
    "./adapters/*": {
      "import": {
        "types": "./dist/types/adapters/*.d.ts",
        "default": "./dist/esm/src/adapters/*.js"
      },
      "require": {
        "types": "./dist/types-cjs/adapters/*.d.ts",
        "default": "./dist/cjs/src/adapters/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:prod": "bun run build.ts --production",
    "build:types": "tsc --project tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build:prod",
    "prepack": "bun run build:prod",
    "release:major": "bun run scripts/release.ts major",
    "release:minor": "bun run scripts/release.ts minor",
    "release:patch": "bun run scripts/release.ts patch",
    "test:package": "bun run scripts/test-package.ts",
    "test:templates": "node scripts/smoke-templates.mjs",
    "benchmark": "bun run benchmarks/run.ts"
  },
  "keywords": [
    "veloce-ts",
    "veloce",
    "fastapi",
    "typescript",
    "web-framework",
    "hono",
    "zod",
    "decorators",
    "validation",
    "openapi",
    "fast",
    "modern",
    "fastapi-typescript",
    "jwt",
    "authentication",
    "rbac",
    "graphql",
    "websocket",
    "sqlite",
    "dependency-injection",
    "middleware",
    "swagger",
    "api-documentation",
    "bun",
    "nodejs",
    "deno"
  ],
  "author": "Alfredo Mejia <mejia_alfredo@outlook.com>",
  "contributors": [
    {
      "name": "ExcessHawk",
      "email": "excesshawk@veloce-ts.com",
      "url": "https://github.com/ExcessHawk",
      "role": "Lead Developer & Framework Architect"
    },
    {
      "name": "Alfredo Mejia",
      "email": "mejia_alfredo@outlook.com",
      "url": "https://github.com/ExcessHawk",
      "role": "Project Founder"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExcessHawk/veloce-ts.git"
  },
  "bugs": {
    "url": "https://github.com/ExcessHawk/veloce-ts/issues"
  },
  "homepage": "https://veloce-ts.com",
  "files": [
    "dist/esm",
    "dist/cjs",
    "dist/types",
    "dist/types-cjs",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "hono": "^4.12.16",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "ioredis": "^5.10.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "graphql": "^17.0.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@hono/node-server": ">=1.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  }
}
